#!/bin/sh
set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  echo "Usage: ./scripts/run-sensitivity CASE [RUN_DIR]" >&2
  exit 2
fi

case_key=$1
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
run_dir=${2:-$repo_dir/runs/$case_key}

if [ -e "$run_dir" ]; then
  echo "Run directory already exists: $run_dir" >&2
  echo "Move or remove it before starting a fresh fit." >&2
  exit 2
fi

model_dir=$repo_dir/models/$case_key
if [ ! -d "$model_dir" ]; then
  echo "Unknown or unmaterialized sensitivity: $case_key" >&2
  echo "Run Rscript scripts/list-sensitivities.R to list valid names." >&2
  exit 2
fi
(
  cd "$model_dir"
  sha256sum -c INPUTS.sha256 >/dev/null
)
mkdir -p "$run_dir"
cp -a "$model_dir/." "$run_dir/"
cp "$repo_dir/mfclo64" "$run_dir/mfclo64"
chmod +x "$run_dir/mfclo64" "$run_dir/doitall.sh"
cd "$run_dir"
PROGRAM_PATH=${PROGRAM_PATH:-./mfclo64} ./doitall.sh
cp 11.par final.par
echo "Completed $case_key: $run_dir/final.par"
