#!/usr/bin/env python3
"""Register and submit the 17 independent BET sensitivity fits to Kflow."""

from __future__ import annotations

import argparse
import csv
import json
import os
import subprocess
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path
from typing import Any

import yaml


ROOT = Path(__file__).resolve().parents[1]
CONFIG_PATH = ROOT / "kflow.yaml"
REGISTRY_PATH = ROOT / "sensitivities.csv"
EXPECTED_TASK = "BET-2026-sensitivity-tau2"
EXPECTED_REPO = "PacificCommunity/ofp-sam-bet-2026-sensitivity"
EXPECTED_BRANCH = "main"
EXPECTED_CASES = 17


def api_json(
    method: str,
    url: str,
    token: str,
    payload: dict[str, Any] | None = None,
) -> dict[str, Any]:
    body = None if payload is None else json.dumps(payload).encode("utf-8")
    headers = {"Authorization": f"Bearer {token}"}
    if body is not None:
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=120) as response:
            raw = response.read()
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"{method} {url} failed: HTTP {exc.code}: {detail}") from exc
    return json.loads(raw.decode("utf-8")) if raw else {}


def run(*args: str) -> str:
    return subprocess.run(
        args,
        cwd=ROOT,
        check=True,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    ).stdout.strip()


def load_inputs() -> tuple[dict[str, Any], list[dict[str, str]]]:
    config = yaml.safe_load(CONFIG_PATH.read_text(encoding="utf-8"))
    with REGISTRY_PATH.open(encoding="utf-8", newline="") as handle:
        rows = [dict(row) for row in csv.DictReader(handle)]
    if not isinstance(config, dict):
        raise ValueError("kflow.yaml must contain a mapping.")
    if config.get("name") != EXPECTED_TASK:
        raise ValueError(f"Kflow task must be {EXPECTED_TASK}.")
    if len(rows) != EXPECTED_CASES:
        raise ValueError(f"Expected {EXPECTED_CASES} sensitivity rows; found {len(rows)}.")
    keys = [row["key"] for row in rows]
    if len(keys) != len(set(keys)):
        raise ValueError("Sensitivity keys are not unique.")
    missing = [key for key in keys if not (ROOT / "models" / key).is_dir()]
    if missing:
        raise ValueError(f"Missing frozen model folders: {', '.join(missing)}")
    if str(config.get("remote_host", "")).lower() != "suva":
        raise ValueError("All sensitivity fits must be submitted through Suva.")
    if "suvofp" not in str(config.get("slot_requirements", "")).lower():
        raise ValueError("Kflow slot requirements do not restrict jobs to Suva workers.")
    if config.get("triggers"):
        raise ValueError("Sensitivity fits must not define sequential triggers.")
    return config, rows


def assert_pushed_main() -> str:
    if run("git", "status", "--porcelain"):
        raise ValueError("Repository has uncommitted changes; commit and push before submission.")
    branch = run("git", "branch", "--show-current")
    if branch != EXPECTED_BRANCH:
        raise ValueError(f"Submission must use {EXPECTED_BRANCH}; current branch is {branch}.")
    head = run("git", "rev-parse", "HEAD")
    remote = run("git", "rev-parse", "origin/main")
    if head != remote:
        raise ValueError("Local main and origin/main differ; push the exact inputs first.")
    return head


def job_title(row: dict[str, str]) -> str:
    title = (
        f"BET sensitivity | {row['label']} | "
        f"{row['reference']} -> {row['alternative']}"
    )
    if len(title) > 140:
        title = f"BET sensitivity | {row['label']}"
    if len(title) > 140:
        raise ValueError(f"Job title is too long for {row['key']}.")
    return title


def job_description(row: dict[str, str]) -> str:
    return (
        "Independent one-at-a-time BET 2026 sensitivity from the Diagnostic model "
        "reproduced by Job 21641. "
        f"Changed axis: {row['axis']}. Reference: {row['reference']}; "
        f"alternative: {row['alternative']}. Implementation: {row['scientific_change']}. "
        "All non-target inputs and controls remain at the Diagnostic reference: fixed "
        "h=0.90 and direct negative-binomial tau=2 unless that is the named axis, 33 "
        "independent selectivity groups with weak F10/F33 non-decreasing penalties, "
        "DM G8/Nmax25, K=0.20, data and biology. Ordinary makepar; no seed or checkpoint."
    )


def report_payload(config: dict[str, Any], source_commit: str) -> dict[str, Any]:
    resources = config["resources"]
    metadata = {
        **dict(config.get("metadata") or {}),
        "local_apps": config.get("local_apps") or [],
        "source_commit": source_commit,
        "campaign_size": EXPECTED_CASES,
        "execution": "independent-concurrent",
        "design": "one-at-a-time",
    }
    return {
        "name": EXPECTED_TASK,
        "description": config["description"],
        "repo_full_name": EXPECTED_REPO,
        "branch": EXPECTED_BRANCH,
        "command": config["command"],
        "docker_image": config["docker_image"],
        "remote_host": config["remote_host"],
        "remote_user": config["remote_user"],
        "remote_base_dir": config["remote_base_dir"],
        "cpus": resources["cpus"],
        "memory": resources["memory"],
        "disk": resources["disk"],
        "slot_requirements": config["slot_requirements"],
        "exclude_machines": config.get("exclude_machines") or [],
        "exclude_slots": config.get("exclude_slots") or [],
        "env": config.get("env") or {},
        "tags": config.get("tags") or {},
        "metadata": metadata,
        "output_patterns": config.get("output_patterns") or [],
        "input_jobs": [],
        "triggers": {},
    }


def job_payload(
    config: dict[str, Any], row: dict[str, str], source_commit: str
) -> dict[str, Any]:
    resources = config["resources"]
    title = job_title(row)
    description = job_description(row)
    env = {
        **dict(config.get("env") or {}),
        "SENSITIVITY_SELECT": row["key"],
        "JOB_KEY": row["key"],
        "JOB_TITLE": title,
        "JOB_DESCRIPTION": description,
        "MODEL_LABEL": row["label"],
        "FLOW_GROUP": "bet-2026-sensitivity-tau2",
    }
    return {
        "repo": EXPECTED_REPO,
        "branch": EXPECTED_BRANCH,
        "command": config["command"],
        "docker_image": config["docker_image"],
        "remote_host": config["remote_host"],
        "remote_user": config["remote_user"],
        "remote_base_dir": config["remote_base_dir"],
        "cpus": resources["cpus"],
        "memory": resources["memory"],
        "disk": resources["disk"],
        "batch_name": "bet-2026-sensitivity-tau2",
        "slot_requirements": config["slot_requirements"],
        "exclude_machines": config.get("exclude_machines") or [],
        "exclude_slots": config.get("exclude_slots") or [],
        "output_patterns": config.get("output_patterns") or [],
        "input_jobs": [],
        "env": env,
        "tags": {
            **dict(config.get("tags") or {}),
            "sensitivity_key": row["key"],
            "axis": row["axis"],
            "reference": row["reference"],
            "alternative": row["alternative"],
            "execution": "independent-concurrent",
        },
        "metadata": {
            **dict(config.get("metadata") or {}),
            "source_commit": source_commit,
            "job_key": row["key"],
            "job_title": title,
            "job_description": description,
            "sensitivity_axis": row["axis"],
            "reference_value": row["reference"],
            "alternative_value": row["alternative"],
            "scientific_change": row["scientific_change"],
            "campaign_size": EXPECTED_CASES,
            "independent_fit": True,
            "inputs_frozen": True,
        },
        "triggers": {},
    }


def existing_jobs(base_url: str, token: str, task: str) -> dict[str, dict[str, Any]]:
    found: dict[str, dict[str, Any]] = {}
    task_path = urllib.parse.quote(task, safe="")
    for page in range(1, 20):
        response = api_json(
            "GET", f"{base_url}/api/jobs/{task_path}/?page={page}", token
        )
        jobs = response.get("jobs") or []
        if not jobs:
            break
        for job in jobs:
            env = job.get("env") or job.get("env_json") or {}
            key = str(env.get("JOB_KEY") or "")
            if key:
                found[key] = job
    return found


def verify_job(
    base_url: str,
    token: str,
    row: dict[str, str],
    job_number: int,
    expected_payload: dict[str, Any],
) -> dict[str, Any]:
    response = api_json("GET", f"{base_url}/api/job/{job_number}/", token)
    job = response.get("job", response)
    env = job.get("env") or job.get("env_json") or {}
    errors: list[str] = []
    expected_task_slug = EXPECTED_TASK.lower()
    if str(job.get("report_code", "")).lower() != expected_task_slug:
        errors.append(f"task={job.get('report_code')}")
    if str(job.get("remote_host", "")).lower() not in {"suva", "suvofpsubmit.corp.spc.int"}:
        errors.append(f"remote_host={job.get('remote_host')}")
    for key in ("SENSITIVITY_SELECT", "JOB_KEY", "JOB_TITLE", "JOB_DESCRIPTION"):
        if str(env.get(key)) != str(expected_payload["env"][key]):
            errors.append(f"{key} mismatch")
    if job.get("input_jobs") not in (None, []):
        errors.append("input_jobs is not empty")
    if errors:
        raise ValueError(f"Job {job_number} ({row['key']}) failed verification: {errors}")
    return {
        "key": row["key"],
        "job_number": job_number,
        "status": job.get("status"),
        "title": env.get("JOB_TITLE"),
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--submit", action="store_true", help="Create the task and jobs.")
    parser.add_argument("--max-workers", type=int, default=17)
    args = parser.parse_args()

    config, rows = load_inputs()
    payload_preview = [job_payload(config, row, "<pushed-main>") for row in rows]
    if not args.submit:
        print(json.dumps({"task": EXPECTED_TASK, "count": len(rows), "jobs": payload_preview}, indent=2))
        return 0

    source_commit = assert_pushed_main()
    subprocess.run(
        ["Rscript", "scripts/validate-sensitivities.R"], cwd=ROOT, check=True
    )
    subprocess.run(["./scripts/smoke-test"], cwd=ROOT, check=True)

    token = os.environ.get("KFLOW_API_TOKEN", "")
    if not token:
        raise SystemExit("Set KFLOW_API_TOKEN before submission.")
    base_url = os.environ.get("KFLOW_URL", "http://127.0.0.1:8089").rstrip("/")
    task_path = urllib.parse.quote(EXPECTED_TASK, safe="")
    api_json(
        "POST",
        f"{base_url}/api/report/{task_path}",
        token,
        report_payload(config, source_commit),
    )

    already = existing_jobs(base_url, token, EXPECTED_TASK)
    pending = [row for row in rows if row["key"] not in already]
    submitted: list[tuple[dict[str, str], int, dict[str, Any]]] = []
    failures: list[str] = []
    with ThreadPoolExecutor(max_workers=max(1, args.max_workers)) as executor:
        futures = {}
        for row in pending:
            payload = job_payload(config, row, source_commit)
            future = executor.submit(
                api_json,
                "POST",
                f"{base_url}/api/job/{task_path}",
                token,
                payload,
            )
            futures[future] = (row, payload)
        for future in as_completed(futures):
            row, payload = futures[future]
            try:
                response = future.result()
                job = response.get("job", response)
                submitted.append((row, int(job["job_number"]), payload))
            except Exception as exc:  # report every row before failing
                failures.append(f"{row['key']}: {exc}")

    verified = []
    for row, number, payload in submitted:
        try:
            verified.append(verify_job(base_url, token, row, number, payload))
        except Exception as exc:
            failures.append(str(exc))
    for row in rows:
        if row["key"] in already:
            job = already[row["key"]]
            number = int(job["job_number"])
            try:
                verified.append(
                    verify_job(
                        base_url,
                        token,
                        row,
                        number,
                        job_payload(config, row, source_commit),
                    )
                )
            except Exception as exc:
                failures.append(str(exc))

    verified.sort(key=lambda item: [row["key"] for row in rows].index(item["key"]))
    result = {
        "task": EXPECTED_TASK,
        "source_commit": source_commit,
        "existing": len(already),
        "submitted": len(submitted),
        "verified": verified,
        "failures": failures,
    }
    print(json.dumps(result, indent=2))
    if failures or len(verified) != EXPECTED_CASES:
        raise SystemExit("Kflow submission or post-submission verification was incomplete.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
